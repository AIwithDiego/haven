{
  "name": "haven-workspace",
  "productName": "Haven",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "A calmer home for your terminal and AI tasks.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && vite build",
    "test": "node --import ./tests/setup-fake-cli.mjs --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --mac dir && node scripts/sign-local.mjs",
    "signing:setup": "node scripts/setup-signing.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "5.0.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@electron/osx-sign": "1.3.3"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "local.haven.workspace",
    "productName": "Haven",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helpers",
        "to": "helpers",
        "filter": [
          "*.py"
        ]
      }
    ],
    "mac": {
      "icon": "build/Haven.icns",
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Haven transcribes your speech locally on this Mac.",
        "NSScreenCaptureUsageDescription": "Haven captures only the region you select to attach to your task."
      },
      "hardenedRuntime": true
    }
  }
}
